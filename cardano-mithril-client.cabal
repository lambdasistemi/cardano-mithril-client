cabal-version:   3.4
name:            cardano-mithril-client
version:         0.1.0.0
synopsis:
  Haskell client library for Mithril Cardano UTxO snapshot download,
  verification, and extraction.

description:
  This library provides functionality to interact with Mithril aggregators
  for retrieving certified Cardano database snapshots. It supports fetching
  snapshot metadata, downloading and verifying snapshots, extracting UTxOs
  from ledger state files, and converting between MemPack and CBOR encoding
  formats.

license:         Apache-2.0
license-file:    LICENSE
author:          Paolo Veronelli
maintainer:      paolo.veronelli@gmail.com
homepage:        https://github.com/lambdasistemi/cardano-mithril-client
bug-reports:
  https://github.com/lambdasistemi/cardano-mithril-client/issues

category:        Cardano
build-type:      Simple
extra-doc-files:
  CHANGELOG.md
  README.md

common warnings
  ghc-options:
    -Wall -Werror -Wunused-imports -Wunused-packages
    -Wmissing-export-lists -Wname-shadowing
    -Wdeferred-out-of-scope-variables -Wpartial-type-signatures
    -Wredundant-constraints

  default-extensions:
    DataKinds
    DerivingStrategies
    DerivingVia
    DuplicateRecordFields
    FlexibleContexts
    FlexibleInstances
    GADTs
    GeneralizedNewtypeDeriving
    ImportQualifiedPost
    LambdaCase
    MultiParamTypeClasses
    NamedFieldPuns
    OverloadedStrings
    PatternSynonyms
    RankNTypes
    RecordWildCards
    ScopedTypeVariables
    StandaloneDeriving
    StrictData
    TupleSections
    TypeApplications
    TypeFamilies
    TypeOperators
    ViewPatterns

library
  import:           warnings
  hs-source-dirs:   lib
  default-language: Haskell2010
  exposed-modules:
    Cardano.Mithril.AncillaryVerifier
    Cardano.Mithril.Client
    Cardano.Mithril.Extraction
    Cardano.Mithril.Import
    Cardano.Mithril.Options
    Cardano.Mithril.Streaming

  build-depends:
    , aeson
    , base                    >=4.18 && <5
    , base16-bytestring
    , bytestring
    , cardano-ledger-babbage
    , cardano-ledger-binary
    , cardano-ledger-conway
    , cardano-ledger-core
    , cborg
    , containers
    , contra-tracer
    , contra-tracer-contrib
    , crypton
    , directory
    , filepath
    , http-client
    , http-types
    , memory
    , mempack
    , mtl
    , opt-env-conf
    , streaming
    , streaming-bytestring
    , text
    , time
    , typed-process

test-suite unit-tests
  import:             warnings
  type:               exitcode-stdio-1.0
  main-is:            Main.hs
  hs-source-dirs:     test
  default-language:   Haskell2010
  build-tool-depends: hspec-discover:hspec-discover
  other-modules:
    Cardano.Mithril.AncillaryVerifierSpec
    Cardano.Mithril.ClientSpec

  build-depends:
    , base                    >=4.18 && <5
    , bytestring
    , cardano-ledger-babbage
    , cardano-ledger-conway
    , cardano-ledger-core
    , cardano-mithril-client
    , containers
    , contra-tracer
    , hspec
    , http-client
    , http-client-tls
    , mempack
    , streaming
    , temporary
