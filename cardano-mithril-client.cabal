cabal-version:   3.4
name:            cardano-mithril-client
version:         0.1.0.0
synopsis:        Mithril client for Cardano UTxO snapshots
description:
  This library provides functionality to interact with Mithril aggregators
  for retrieving certified Cardano database snapshots. It supports fetching
  snapshot metadata, downloading and verifying snapshots, extracting UTxOs
  from ledger state files, and converting between MemPack and CBOR encoding
  formats.

license:         Apache-2.0
license-file:    LICENSE
author:          Paolo Veronelli
maintainer:      paolo.veronelli@gmail.com
homepage:        https://github.com/lambdasistemi/cardano-mithril-client
bug-reports:
  https://github.com/lambdasistemi/cardano-mithril-client/issues

category:        Cardano
build-type:      Simple
extra-doc-files:
  CHANGELOG.md
  README.md

flag dev
  description: Enable -Werror for development
  default:     False
  manual:      True

common warnings
  ghc-options:
    -Wall -Wunused-imports -Wunused-packages -Wmissing-export-lists
    -Wname-shadowing -Wdeferred-out-of-scope-variables
    -Wpartial-type-signatures -Wredundant-constraints

  if flag(dev)
    ghc-options: -Werror

  default-extensions:
    DataKinds
    DerivingStrategies
    DerivingVia
    DuplicateRecordFields
    FlexibleContexts
    FlexibleInstances
    GADTs
    GeneralizedNewtypeDeriving
    ImportQualifiedPost
    LambdaCase
    MultiParamTypeClasses
    NamedFieldPuns
    OverloadedStrings
    PatternSynonyms
    RankNTypes
    RecordWildCards
    ScopedTypeVariables
    StandaloneDeriving
    StrictData
    TupleSections
    TypeApplications
    TypeFamilies
    TypeOperators
    ViewPatterns

library
  import:           warnings
  hs-source-dirs:   lib
  default-language: Haskell2010
  exposed-modules:
    Cardano.Mithril.AncillaryVerifier
    Cardano.Mithril.Client
    Cardano.Mithril.Extraction
    Cardano.Mithril.Import
    Cardano.Mithril.Options
    Cardano.Mithril.Streaming

  build-depends:
    , aeson                   >=2.2    && <2.3
    , base                    >=4.18   && <5
    , base16-bytestring       >=1.0    && <1.1
    , bytestring              >=0.12   && <0.13
    , cardano-ledger-babbage  >=1.12   && <1.13
    , cardano-ledger-binary   >=1.7    && <1.8
    , cardano-ledger-conway   >=1.20   && <1.21
    , cardano-ledger-core     >=1.18   && <1.19
    , cborg                   >=0.2.10 && <0.3
    , containers              >=0.6    && <0.8
    , contra-tracer           >=0.1    && <0.2
    , contra-tracer-contrib   >=0.1    && <0.2
    , crypton                 >=1.0    && <1.1
    , directory               >=1.3    && <1.4
    , filepath                >=1.4    && <1.6
    , http-client             >=0.7    && <0.8
    , http-types              >=0.12   && <0.13
    , memory                  >=0.18   && <0.19
    , mempack                 >=0.1    && <0.2
    , mtl                     >=2.3    && <2.4
    , opt-env-conf            >=0.13   && <0.14
    , streaming               >=0.2    && <0.3
    , streaming-bytestring    >=0.3    && <0.4
    , text                    >=2.1    && <2.2
    , time                    >=1.12   && <1.13
    , typed-process           >=0.2    && <0.3

test-suite unit-tests
  import:             warnings
  type:               exitcode-stdio-1.0
  main-is:            Main.hs
  hs-source-dirs:     test
  default-language:   Haskell2010
  build-tool-depends: hspec-discover:hspec-discover
  other-modules:
    Cardano.Mithril.AncillaryVerifierSpec
    Cardano.Mithril.ClientSpec

  build-depends:
    , base                    >=4.18 && <5
    , bytestring              >=0.12 && <0.13
    , cardano-ledger-babbage  >=1.12 && <1.13
    , cardano-ledger-conway   >=1.20 && <1.21
    , cardano-ledger-core     >=1.18 && <1.19
    , cardano-mithril-client
    , containers              >=0.6  && <0.8
    , contra-tracer           >=0.1  && <0.2
    , hspec                   >=2.11 && <2.12
    , http-client             >=0.7  && <0.8
    , http-client-tls         >=0.3  && <0.4
    , mempack                 >=0.1  && <0.2
    , streaming               >=0.2  && <0.3
    , temporary               >=1.3  && <1.4
